# =====================================================================
# LSF Batch Queues - lsb.queues
# =====================================================================

Begin Queue
QUEUE_NAME   = normal
PRIORITY     = 20
USERS        = all
HOSTS        = master
DESCRIPTION  = Standard queue for local on-premises workloads.
End Queue

Begin Queue
QUEUE_NAME   = eda
PRIORITY     = 30
USERS        = all
# Allow running on both local master (for testing) and dynamic GCP hosts
HOSTS        = master allremote
# Enable cloud bursting via the GCP provider
RC_HOSTS     = googlehost
# Trigger cloud bursting if 1 job pends for 1 minute
RC_DEMAND_POLICY = THRESHOLD[[1, 1]]
DESCRIPTION  = High-throughput queue for EDA workloads bursting to GCP.
End Queue

Begin Queue
QUEUE_NAME       = spillover
PRIORITY         = 30
USERS            = all
# Allow running on both local master (for testing) and dynamic GCP hosts
HOSTS            = master allremote
# Enable dynamic borrowing of GCP hosts
RC_HOSTS         = googlehost
# Trigger cloud burst as soon as 1 job pends for 0 minutes (instant)
RC_DEMAND_POLICY = THRESHOLD[[1, 0]]
# Direct jobs strictly to the c2-standard-8 and n2-standard-8 spillover templates
RES_REQ          = select[googlehost && (eda_type == spillover_8core)]
DESCRIPTION      = Spillover queue: bursts to h4d-standard-192 first, spilling over to c2-standard-8, then n2-standard-8.
End Queue

