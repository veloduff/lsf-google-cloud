# =====================================================================
# Terraform Variable Definitions (terraform.tfvars)
# =====================================================================
# Copy this file to 'terraform.tfvars' and set your custom values.
# Values defined here WILL PERSIST across all terraform commands and helper scripts.

project_id      = "your-gcp-project-id"
region          = "us-central1"
zone            = "us-central1-a"

# Optional: Custom GCS Bucket Name (defaults to lsf-install-bucket-<random_id>)
# bucket_name   = "my-custom-lsf-bucket"

# Optional: GCS Location (defaults to US)
# bucket_location = "US"

# Optional: Allowed SSH source CIDR ranges (defaults to IAP range ["35.235.240.0/20"])
# For initial testing from any IP, uncomment the line below:
# ssh_source_ranges = ["0.0.0.0/0"]
